# Copy to .env (never commit real keys).

# --- search provider -------------------------------------------------------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-your-key-here
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
PROVIDER_FALLBACK=local

# --- llama.cpp server ------------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:8099/v1
LLM_MODEL=qwen2.5-0.5b-instruct
LLM_TIMEOUT=120
LLM_CACHE_PROMPT=true

# --- latency / token budget ------------------------------------------------
# auto = skip the planner LLM call for short, simple queries.
PLANNER_MODE=auto
MAX_SUB_QUERIES=2
MAX_ROUNDS=2
MAX_SNIPPETS=3
EVIDENCE_CHAR_BUDGET=1000
SNIPPET_CHAR_LIMIT=280
MAX_RESPONSE_WORDS=45
MAX_SOURCES=3
PLANNER_MAX_TOKENS=48
ANSWER_MAX_TOKENS=80
GAP_MAX_TOKENS=32
GROUND_COVERAGE=0.6
GAP_MIN_COVERAGE=0.6
MIN_RESULT_COVERAGE=0.2

# --- self-hosted AMD docs (optional, replaces Tavily) ----------------------
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=amd_docs
# QDRANT_API_KEY=
# QDRANT_TOP_K=6
# QDRANT_EMBED_URL=http://127.0.0.1:8099/v1/embeddings
# QDRANT_EMBED_MODEL=nomic-embed-text
# Or use an offline JSONL corpus:
# SEARCH_PROVIDER=local
# LOCAL_CORPUS_PATH=corpus/amd_docs.jsonl
